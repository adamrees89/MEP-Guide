issn = {0142-9612},
journal = {Biomaterials},
keywords = {Biocompatible Materials,Calorimetry,Cholagogues and Choleretics,Cholagogues and Choleretics: pharmacology,Cross-Linking Reagents,Cross-Linking Reagents: pharmacology,Differential Scanning,Gelatin,Gelatin: chemistry,Iridoid Glycosides,Iridoids,Pyrans,Pyrans: pharmacology,Temperature,Time Factors},
month = {dec},
