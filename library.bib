journal = {Energy and Buildings},
keywords = {Building stock energy refurbishment,Building stock refurbishment trend,CO2emission reduction,Climate protection targets,Energy refurbishment scenario},
title = {{Refurbishment trends of the residential building stock: Analysis of a regional pilot case in Italy}},
year = {2016}
}
