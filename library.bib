@phdthesis{Rees2011,
abstract = {Throughout this report the real-world applications for printed biosensors in the medical industry will be explored. Before looking at the applications a brief overview of the printing technologies used throughout the manufacture will be given. The applications explored will include: detection and monitoring of illnesses, detection/quantification of drug misuse or poisonings, and wound monitoring thorough the use of ‘smart bandages'. Once the potential applications have been reviewed the currently available commercial technologies will be looked at, products such as the Rapid Biosensor Systems tuberculosis breathalyser, and the UbiMon sensor network.},
