journal = {Biomaterials},
keywords = {Adipose Tissue,Adipose Tissue: cytology,Animals,Biocompatible Materials,Biocompatible Materials: chemistry,Cell Culture Techniques,Cell Culture Techniques: instrumentation,Cell Culture Techniques: methods,Cells, Cultured,Connective Tissue,Connective Tissue: anatomy {\&} histology,Connective Tissue: physiology,Humans,Materials Testing,Microscopy, Electron, Scanning,Stromal Cells,Stromal Cells: cytology,Stromal Cells: physiology,Surface Properties,Tissue Engineering,Tissue Engineering: instrumentation,Tissue Engineering: methods,Tissue Scaffolds,Tissue Scaffolds: chemistry},
month = {may},
