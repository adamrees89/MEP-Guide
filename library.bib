isbn = {0306-2619},
issn = {03062619},
journal = {Applied Energy},
keywords = {Compressed air energy storage,Optimization,Power systems economics,Stochastic systems,Wind energy},
title = {{Optimization of specific rating for wind turbine arrays coupled to compressed air energy storage}},
