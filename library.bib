issn = {18387640},
journal = {Theranostics},
keywords = {Autoradiography ex vivo,Biomaterials,Computed tomography,Magnetic resonance imaging,Optical imaging,Positron emission tomography},
number = {12},
pages = {2114--2128},
pmid = {27698944},
title = {{Gelatin-based hydrogel degradation and tissue interaction in vivo: Insights from multimodal preclinical imaging in immunocompetent nude mice}},
volume = {6},
year = {2016}
}
