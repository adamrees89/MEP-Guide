file = {:C$\backslash$:/Users/Adam/Documents/Mendeley Desktop//Crouch et al. - 2005 - Amperometric, screen-printed, glucose biosensor for analysis of human plasma samples using a biocomposite water-b.pdf:pdf},
issn = {0003-2697},
journal = {Analytical biochemistry},
keywords = {Biosensing Techniques,Blood Glucose,Blood Glucose: analysis,Carbon,Carbon: chemistry,Catalysis,Glucose Oxidase,Glucose Oxidase: chemistry,Humans,Hydrogen-Ion Concentration,Indoles,Indoles: chemistry,Ink,Organometallic Compounds,Organometallic Compounds: chemistry,Potentiometry,Potentiometry: methods,Printed Electrodes Medical Biosensor,Serum,Serum: chemistry,Temperature,Water,Water: chemistry},
mendeley-tags = {Printed Electrodes Medical Biosensor},
month = {dec},
number = {1},
pages = {17--23},
pmid = {16266677},
title = {{Amperometric, screen-printed, glucose biosensor for analysis of human plasma samples using a biocomposite water-based carbon ink incorporating glucose oxidase.}},
