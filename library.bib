keywords = {Gray-box model,Inverse problem,Lumped thermal parameter,System identification,Thermal network model,Urban Heat Island,Urban canopy model},
title = {{Inverse modeling of the urban energy system using hourly electricity demand and weather measurements, Part 2: Gray-box model}},
