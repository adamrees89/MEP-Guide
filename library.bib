keywords = {Biocompatible Materials,Biocompatible Materials: chemistry,Biocompatible Materials: pharmacology,Cell Line,Cell Proliferation,Cell Proliferation: drug effects,Cell Survival,Cell Survival: drug effects,Epithelial Cells,Epithelial Cells: cytology,Epithelial Cells: drug effects,Epithelial Cells: metabolism,Gelatin,Gelatin: chemistry,Gelatin: pharmacology,Glutamic Acid,Glutamic Acid: metabolism,Humans,Interleukin-6,Interleukin-6: genetics,Interleukin-6: metabolism,Mitochondria,Mitochondria: enzymology,Oxidoreductases,Oxidoreductases: metabolism,Retinal Pigments,Retinal Pigments: metabolism,Rheology},
