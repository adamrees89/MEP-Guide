keywords = {Aged,Arthroplasty,Cost of Illness,Cost-Benefit Analysis,Cross-Sectional Studies,Databases,Factual,Female,Health Care Costs,Hip,Hip Prosthesis,Hip Prosthesis: economics,Hip: economics,Hip: statistics {\&} numer,Humans,Knee,Knee Prosthesis,Knee Prosthesis: economics,Knee: economics,Knee: statistics {\&} nume,Male,Middle Aged,Needs Assessment,Replacement,United States},
number = {18},
