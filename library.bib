file = {:C$\backslash$:/Users/Adam/Documents/Mendeley Desktop/Omitaomu et al. - 2012 - Adapting a GIS-based multicriteria decision analysis approach for evaluating new power generating sites.pdf:pdf},
isbn = {0306-2619},
