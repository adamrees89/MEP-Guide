journal = {Applied Energy},
keywords = {Backcasting method,EU Energy Strategy,Energy needs,Energy security,Knowledge centre,Virtual needs},
title = {{Use of renewable energy sources in light of the " New Energy Strategy for Europe 2011-2020"}},
year = {2012}
}
