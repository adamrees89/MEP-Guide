@phdthesis{Rees2012,
abstract = {The purpose of this project is to investigate the feasibility of printed conductive tracks. The experimental phase of this project used screen printing to create the samples, and is split into two phases, preliminary and final testing. In the preliminary phase a comparison of ink types, printed side, and direction will be made, and the lessons learnt will be used to improve the method in the final phase of testing. The basic conductance test in the final phase showed that a printed conductive track is feasible, with good conductivity. However, further testing showed that the tracks did not remain conductive after stretching and washing. This leads to the conclusion that the tracks are not yet feasible as they do not work during what can be considered normal use.},
