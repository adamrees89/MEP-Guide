issn = {1748-605X},
journal = {Biomedical materials (Bristol, England)},
keywords = {Animals,Bone Development,Bone Development: physiology,Bone and Bones,Bone and Bones: cytology,Cell Differentiation,Cell Differentiation: physiology,Cell Proliferation,Cells, Cultured,Humans,Osteoblasts,Osteoblasts: cytology,Osteoblasts: physiology,Osteogenesis,Osteogenesis: physiology,Stem Cells,Stem Cells: cytology,Stem Cells: physiology,Tissue Engineering,Tissue Engineering: methods,Tissue Engineering: trends},
month = {dec},
