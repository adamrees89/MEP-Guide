file = {:C$\backslash$:/Users/Adam/Documents/Mendeley Desktop/Mannoor et al. - 2013 - 3D Printed Bionic Ears.pdf:pdf},
issn = {1530-6992},
journal = {Nano letters},
keywords = {1,2,additive manufacturing,bioelectronics,capabilities,cybernetics,cyborg organs,devices that enhance human,electronic implants,has been an area,he design and implementation,known as,of bionic organs and,of increasing scientific interest,tissue engineering},
month = {may},
