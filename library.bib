issn = {1878-0180},
journal = {Journal of the mechanical behavior of biomedical materials},
keywords = {Animals,Biocompatible Materials,Biocompatible Materials: chemistry,Biocompatible Materials: metabolism,Biocompatible Materials: pharmacology,Cattle,Cell Adhesion,Cell Adhesion: drug effects,Cell Line, Tumor,Collagen,Collagen: chemistry,Collagen: metabolism,Compressive Strength,Cost-Benefit Analysis,Elastin,Elastin: chemistry,Elastin: metabolism,Extracellular Matrix,Extracellular Matrix: metabolism,Gelatin,Gelatin: chemistry,Gelatin: metabolism,Humans,Materials Testing,Mechanical Processes,Models, Molecular,Protein Conformation,Tensile Strength,Tissue Engineering,Tissue Engineering: economics,Tissue Scaffolds,Tissue Scaffolds: chemistry},
