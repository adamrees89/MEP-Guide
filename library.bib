issn = {0142-9612},
journal = {Biomaterials},
keywords = {Animals,Anterior Cruciate Ligament,Anterior Cruciate Ligament: cytology,Anterior Cruciate Ligament: injuries,Anterior Cruciate Ligament: physiology,Anterior Cruciate Ligament: surgery,Biomechanics,Cells, Cultured,Collagen,Collagen: biosynthesis,DNA,DNA: metabolism,Materials Testing,Mesenchymal Stem Cell Transplantation,Rabbits,Regeneration,Silk,Tissue Engineering,Tomography, X-Ray Computed,Transcription, Genetic},
month = {aug},
