@article{Sousa2012,
abstract = {Energy resource scheduling becomes increasingly important, as the use of distributed resources is intensified and massive gridable vehicle use is envisaged. The present paper proposes a methodology for day-ahead energy resource scheduling for smart grids considering the intensive use of distributed generation and of gridable vehicles, usually referred as Vehicle-to-Grid (V2G). This method considers that the energy resources are managed by a Virtual Power Player (VPP) which established contracts with V2G owners. It takes into account these contracts, the users' requirements subjected to the VPP, and several discharge price steps. Full AC power flow calculation included in the model allows taking into account network constraints.The influence of the successive day requirements on the day-ahead optimal solution is discussed and considered in the proposed model.A case study with a 33 bus distribution network and V2G is used to illustrate the good performance of the proposed method. {\textcopyright} 2012 Elsevier Ltd.},
author = {Sousa, Tiago and Morais, Hugo and Soares, Jo{\~{a}}o and Vale, Zita},
doi = {10.1016/j.apenergy.2012.01.053},
