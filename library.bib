journal = {Applied Energy},
keywords = {Clean and low-carbon energy,Energy generation,Energy policy,Geographic information system,Multicriteria assessment,Spatial analysis},
title = {{Adapting a GIS-based multicriteria decision analysis approach for evaluating new power generating sites}},
year = {2012}
