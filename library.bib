file = {:C$\backslash$:/Users/Adam/Documents/Mendeley Desktop/Setti et al. - 2005 - An amperometric glucose biosensor prototype fabricated by thermal inkjet printing.pdf:pdf},
issn = {0956-5663},
journal = {Biosensors {\&} bioelectronics},
keywords = {Aspergillus niger,Aspergillus niger: enzymology,Biosensing Techniques,Biosensing Techniques: instrumentation,Biosensing Techniques: methods,Biosensor Ink Formulation,Blood Glucose,Blood Glucose: analysis,Coated Materials, Biocompatible,Coated Materials, Biocompatible: chemistry,Computer Peripherals,Electrochemistry,Electrochemistry: instrumentation,Electrochemistry: methods,Equipment Design,Equipment Failure Analysis,Feasibility Studies,Glucose,Glucose Oxidase,Glucose Oxidase: analysis,Glucose Oxidase: chemistry,Glucose: analysis,Glucose: chemistry,Hot Temperature,Pilot Projects,Printing,Printing: instrumentation},
