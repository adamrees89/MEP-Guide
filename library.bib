journal = {Energy and Buildings},
keywords = {Albedo degradation,Energy simulations,High albedo roof coatings,Microbiological analysis},
pmid = {113104235},
title = {{On the ageing of cool roofs: Measure of the optical degradation, chemical and biological analysis and assessment of the energy impact}},
year = {2016}
}
@article{Simonetti2016,
abstract = {This paper presents the general concept of the NAC (Natural Air Conditioning)-wall system and some experimental results on a first prototype. The originality of the system is to perform a solar DEC (Desiccant, Evaporative Cooling) open cycle by exploiting natural buoyancy driven ventilation, thus avoiding the use of fans. The supply air is dehumidified by a zeolite based adsorption bed and is cooled indirectly by an evaporative cooler, through a low pressure heat exchanger. Eight days measurements were performed, each including a sample with five adsorption/regeneration cycles. During the first measurements, thermal COPs were in the range 0.30 1.01, depending on duration of regeneration and absorption phases. This led to a better tuning of the system, which gave for the remaining samples an average COPthof 0.64, with an average electrical COP of 12.7, calculated considering electrical consumption of water loops pumps.},
author = {Simonetti, Marco and Chiesa, Giacomo and Grosso, Mario and Fracastoro, Gian Vincenzo},
doi = {10.1016/j.enbuild.2016.07.065},
file = {:C$\backslash$:/Users/Adam/Documents/Mendeley Desktop/Simonetti et al. - 2016 - NAC wall An open cycle solar-DEC with naturally driven ventilation.pdf:pdf},
isbn = {0378-7788},
issn = {03787788},
journal = {Energy and Buildings},
keywords = {HNAC,Low energy cooling,Natural ventilation,Solar DEC,Zeolite},
title = {{NAC wall: An open cycle solar-DEC with naturally driven ventilation}},
year = {2016}
}
