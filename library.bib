keywords = {Animals,Biosensing Techniques,Biosensing Techniques: instrumentation,Biosensing Techniques: methods,Blood Glucose,Blood Glucose: analysis,Glucose Tolerance Test,Humans,Lactic Acid,Lactic Acid: blood,Microdialysis,Miniaturization,Monitoring, Physiologic,Monitoring, Physiologic: instrumentation,Monitoring, Physiologic: methods,Myocardial Ischemia,Myocardial Ischemia: blood,Swine,Ultrafiltration},
month = {dec},
